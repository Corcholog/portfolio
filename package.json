{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components content lib scripts tests proxy.ts next.config.ts vitest.config.mts eslint.config.mjs package.json tsconfig.json",
    "format:check": "prettier --check app components content lib scripts tests proxy.ts next.config.ts vitest.config.mts eslint.config.mjs package.json tsconfig.json",
    "check:content": "node scripts/check-content.ts",
    "test": "vitest run tests/unit",
    "test:output": "vitest run tests/output.test.ts",
    "prebuild": "npm run check:content"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
